# =====================================================================
# DON SEGUNDO · VARIABLES DE ENTORNO
# Copiá este archivo a .env.local (desarrollo) y cargá los mismos
# nombres en Vercel → Project → Settings → Environment Variables.
# =====================================================================

# --- Supabase (Project Settings → API) ---------------------------------
# URL del proyecto de PRODUCCIÓN.
NEXT_PUBLIC_SUPABASE_URL=https://uzpqivhshhwvfmpscbme.supabase.co
# Clave PUBLICABLE (sb_publishable_... o la "anon public").
# Es pública por diseño: la seguridad real la dan las políticas RLS.
# NUNCA pongas acá la service_role / secret key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Sitio -------------------------------------------------------------
# Dominio final con https y sin barra al final (para SEO, sitemap y
# vista previa al compartir el link por WhatsApp/Instagram).
NEXT_PUBLIC_SITE_URL=https://www.donsegundobarberia.com.ar

# WhatsApp de la barbería en formato internacional, solo números
# (ej: 5493442123456). Vacío = no se muestran botones de WhatsApp.
NEXT_PUBLIC_BARBERSHOP_WHATSAPP=

# --- Panel de administración (SOLO SERVIDOR, sin NEXT_PUBLIC_) ---------
# Emails autorizados a entrar a /admin, separados por coma.
ADMIN_EMAILS=
